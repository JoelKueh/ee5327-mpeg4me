# =============================================================================
# ee5327-mpeg4me — build system
#
# Full search motion estimator (architecture: refs/arch_asic/key.pdf).
#
# Simulation (local, Verilator):
#   make            build the model (verilator --cc)
#   make lint       lint-only pass (-Wall), no C++ build
#   make run        build + run simulation (requires a C++ testbench)
#   make wave       run + open waveforms in GTKWave
#   make clean      remove build artifacts
#   make filelist   generate synth/filelist.f (ordered source list)
#   make synth      (reserved) Design Compiler flow on remote host
#   make help       print this help
#
# svunit testbenches (local, Verilator; sources in src/tb):
#   make test         build + run every testsuite (module + full level)
#   make test-waves   run all tests + open per-test VCDs in surfer
#   make test-module  run the module-level testsuite (src/tb/module) only
#   make test-full    run the full-level testsuite (src/tb/full) only
#   make farm-test    run all testsuites on the farm with VCS (vlsi)
#   make list-tests   list the registered tests without running them
#
# Override from the command line, e.g.:
#   make TOP_MODULE=fs_computer
#   make TRACE=1
# =============================================================================

TOP_MODULE ?= me_top
BUILD_DIR  ?= build
VCS        ?= vcs

RTL_SOURCES := \
    $(realpath src/hdl/me_pkg.sv) \
    $(realpath src/hdl/sram_if.sv) \
    $(realpath src/hdl/sad_result_if.sv) \
    $(realpath src/hdl/fs/fs_pe.sv) \
    $(realpath src/hdl/fs/fs_pe_array.sv) \
    $(realpath src/hdl/fs/fs_computer.sv) \
	$(realpath src/hdl/fs/fs_combiner.sv) \
	$(realpath src/hdl/fs/fs_comparator.sv) \
	$(realpath src/hdl/fs/fs_control.sv) \
	$(realpath src/hdl/me_top.sv)

SIM_SOURCES := \
	$(realpath src/tb/common/fs_tb_common_pkg.sv)

VCS_FLAGS := -full64 -Mupdate +v2k -sverilog -timescale=1ns/10ps -work build/work -kdb -debug_all \
			 -l compile.log

SVUNIT_OUT   := $(BUILD_DIR)/svunit
SVUNIT_DUT_F := $(SVUNIT_OUT)/dut.f
SVUNIT_DIRS := $(foreach d,src/tb/module src/tb/full,--directory $(d))

SVUNIT_FLAGS := -s vcs -o $(SVUNIT_OUT) -f $(SVUNIT_DUT_F) \
                -c -full64 -c -Mupdate -c +v2k -c -sverilog -c -timescale=1ns/10ps -c -kdb \
				-c -debug_all -c "-l compile.log"

export SVUNIT_INSTALL := $(CURDIR)/lib/svunit
export PATH := $(CURDIR)/lib/svunit/bin:$(PATH)

# ----- Build -----------------------------------------------------------------

.DEFAULT_GOAL := all
all: build

build: $(RTL_SOURCES)
	@mkdir -p build
	@cd $(BUILD_DIR)
	$(VCS) $(VCS_FLAGS) $(RTL_SOURCES) -top $(TOP_MODULE)
	@cd ../

clean:
	rm -rf $(BUILD_DIR) $(FILELIST) *.vcd

# ----- SVUnit -----------------------------------------------------------------

$(SVUNIT_DUT_F): $(RTL_SOURCES)
	@mkdir -p $(dir $@)
	@echo '# generated by make test - do not edit' > $@
	@for f in $(RTL_SOURCES); do echo $$f >> $@; done
	@for f in $(SIM_SOURCES); do echo $$f >> $@; done

test: $(SVUNIT_DUT_F)
	runSVUnit $(SVUNIT_FLAGS) $(SVUNIT_DIRS)

test-module: $(SVUNIT_DUT_F)
	runSVUnit $(SVUNIT_FLAGS) --directory src/tb/module

test-full: $(SVUNIT_DUT_F)
	runSVUnit $(SVUNIT_FLAGS) --directory src/tb/full

list-tests: $(SVUNIT_DUT_F)
	runSVUnit $(SVUNIT_FLAGS) $(SVUNIT_DIRS) --list-tests

# ----- Synthesis (Synopsys Design Compiler, remote) --------------------------

DC_HOST   ?= vlsi
DC_DIR    ?=                # remote directory holding this checkout
DC_SCRIPT ?= synth/$(TOP_MODULE).do
FILELIST  := synth/filelist.f

# Ordered source list; DC requires packages/interfaces to be analyzed before
# the modules that use them, so this mirrors the order above.
filelist: $(FILELIST)

$(FILELIST): $(RTL_SOURCES)
	@mkdir -p $(dir $@)
	@echo '# generated by make filelist - do not edit' > $@
	@for f in $(RTL_SOURCES); do echo $$f >> $@; done

synth: filelist
	@echo "DC synthesis flow not implemented yet - see the SYNTHESIS section header." >&2
	@exit 1

# ----- Help -----------------------------------------------------------------------

.PHONY: all build clean test test-module test-full list-tests filelist synth
