@article{key,
  author = {Cheeckottu Vayalil, Niras and Kong, Yinan},
  title = {VLSI Architecture of Full-Search Variable-Block-Size Motion Estimation for HEVC Video Encoding},
  journal = {IET Circuits, Devices \& Systems},
  volume = {11},
  number = {6},
  pages = {543-548},
  keywords = {video coding, VLSI, motion estimation, real-time systems, frequency 282 MHz, vertical directions, horizontal directions, 4K-UHD, real-time ultra-high-definition, VHDL, motion estimation accelerator, multiple processing elements, data broadcasting, data bandwidth demand, absolute differences reuse strategy, data reading, Morton order, H.265 specification, high-efficiency video coding video encoding, full-search variable-block-size ME, VLSI, very large-scale integration architecture},
  doi = {https://doi.org/10.1049/iet-cds.2016.0267},
  url = {https://ietresearch.onlinelibrary.wiley.com/doi/abs/10.1049/iet-cds.2016.0267},
  eprint = {https://ietresearch.onlinelibrary.wiley.com/doi/pdf/10.1049/iet-cds.2016.0267},
  abstract = {Motion estimation (ME) is the most computationally intensive task in video encoding. This study proposes a full-search variable-block-size ME for the high-efficiency video coding or H.265 specification. The proposed method reduces memory requirements to a large extent by following a Morton order for data reading and a sum of absolute differences reuse strategy. The data bandwidth demand is also diminished by broadcasting data into multiple processing elements. This ME accelerator supports variable-block-size prediction blocks ranging from to , and is reconfigurable in various search ranges for a trade-off between performance and area. The proposed method for very-large-scale integration (VLSI) architecture is synthesized with 32 nm technology, and is capable of real-time encoding of ultra-high-definition (4K-UHD, at 30 Hz) video with a search range of 64 pixels in both horizontal and vertical directions, operating at a frequency of 282 MHz.},
  year = {2017}
}

