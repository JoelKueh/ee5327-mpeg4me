library (sram_macros_lib) {
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    pulling_resistance_unit : "1kohm";
    leakage_power_unit : "1uW";
    capacitive_load_unit (1, pf);

    nom_process : 1.0;
    nom_temperature : 25.0;
    nom_voltage : 0.8;

    operating_conditions (tt0p8v25c) {
        process : 1.0;
        temperature : 25.0;
        voltage : 0.8;
        tree_type : "balanced_tree";
    }
    default_operating_conditions : tt0p8v25c;

    /* Default attributes */
    default_fanout_load : 1.0;
    default_inout_pin_cap : 0.002;
    default_input_pin_cap : 0.002;
    default_output_pin_cap : 0.0;
    default_max_transition : 0.15;

    slew_lower_threshold_pct_rise : 20.0;
    slew_upper_threshold_pct_rise : 80.0;
    slew_lower_threshold_pct_fall : 20.0;
    slew_upper_threshold_pct_fall : 80.0;
    input_threshold_pct_rise : 50.0;
    input_threshold_pct_fall : 50.0;
    output_threshold_pct_rise : 50.0;
    output_threshold_pct_fall : 50.0;

    /* Bus Type Definitions */
    type (bus_7) {
        base_type : array;
        data_type : bit;
        bit_width : 7;
        bit_from : 6;
        bit_to : 0;
        downto : true;
    }
    type (bus_96) {
        base_type : array;
        data_type : bit;
        bit_width : 96;
        bit_from : 95;
        bit_to : 0;
        downto : true;
    }
    type (bus_104) {
        base_type : array;
        data_type : bit;
        bit_width : 104;
        bit_from : 103;
        bit_to : 0;
        downto : true;
    }
    type (bus_112) {
        base_type : array;
        data_type : bit;
        bit_width : 112;
        bit_from : 111;
        bit_to : 0;
        downto : true;
    }
    type (bus_120) {
        base_type : array;
        data_type : bit;
        bit_width : 120;
        bit_from : 119;
        bit_to : 0;
        downto : true;
    }

    /* 1x1 Scalar Templates for Blackbox Synthesis */
    lu_table_template (scalar_template) {
        variable_1 : total_output_net_capacitance;
        index_1 ("0.01");
    }
    lu_table_template (constraint_scalar) {
        variable_1 : constrained_pin_transition;
        index_1 ("0.01");
    }

    /* =================================================================
     * CELL 1: sram_128x96 (12,288 bits, 1R1W 2-Port)
     * Area: 2723.3 um^2 (~0.222 um^2/bit incl. 2P decoders & I/O)
     * Access Time: 305 ps (ref: Yabuuchi et al., VLSI 2016: 313 ps)
     * ================================================================= */
    cell (sram_128x96) {
        area : 2723.3;
        dont_touch : true;
        dont_use : true;
        is_macro_cell : true;
        interface_timing : true;
        cell_leakage_power : 10.4;

        pin (CLK) {
            direction : input;
            clock : true;
            capacitance : 0.006;
            min_pulse_width_high : 0.14;
            min_pulse_width_low : 0.14;
            timing () {
                timing_type : min_clock_tree_path;
                timing_sense : positive_unate;
                cell_rise (scalar_template) { values ("0.0"); }
                cell_fall (scalar_template) { values ("0.0"); }
            }
        }

        pin (WEN) {
            direction : input;
            capacitance : 0.003;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.045"); }
                fall_constraint (constraint_scalar) { values ("0.045"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        pin (REN) {
            direction : input;
            capacitance : 0.003;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.045"); }
                fall_constraint (constraint_scalar) { values ("0.045"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        pin (DFT_BYPASS) {
            direction : input;
            capacitance : 0.004;
        }

        bus (WADDR) {
            bus_type : bus_7;
            direction : input;
            capacitance : 0.003;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.050"); }
                fall_constraint (constraint_scalar) { values ("0.050"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        bus (RADDR) {
            bus_type : bus_7;
            direction : input;
            capacitance : 0.003;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.050"); }
                fall_constraint (constraint_scalar) { values ("0.050"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        bus (WDATA) {
            bus_type : bus_96;
            direction : input;
            capacitance : 0.002;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.040"); }
                fall_constraint (constraint_scalar) { values ("0.040"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        bus (RDATA) {
            bus_type : bus_96;
            direction : output;
            max_capacitance : 0.080;
            timing () {
                related_pin : "CLK";
                timing_type : rising_edge;
                timing_sense : non_unate;
                cell_rise (scalar_template) { values ("0.305"); }
                rise_transition (scalar_template) { values ("0.030"); }
                cell_fall (scalar_template) { values ("0.305"); }
                fall_transition (scalar_template) { values ("0.030"); }
            }
        }
    }

