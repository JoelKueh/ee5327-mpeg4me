                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.015"); }
                fall_constraint (constraint_scalar) { values ("0.015"); }
            }
        }

        pin (REN) {
            direction : input;
