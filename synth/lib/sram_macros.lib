            direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.10"); } fall_constraint (constraint_template) { values ("0.10"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (WADDR) {
            bus_type : bus_5; direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.10"); } fall_constraint (constraint_template) { values ("0.10"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (RADDR) {
