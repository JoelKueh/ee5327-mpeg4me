library (sram_macros_lib) {
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    pulling_resistance_unit : "1kohm";
    leakage_power_unit : "1uW";
    capacitive_load_unit (1, pf);

    nom_process : 1.0;
    nom_temperature : 25.0;
    nom_voltage : 0.8;

    operating_conditions (tt0p8v25c) {
        process : 1.0;
        temperature : 25.0;
        voltage : 0.8;
        tree_type : "balanced_tree";
    }
    default_operating_conditions : tt0p8v25c;

    /* Default attributes */
    default_fanout_load : 1.0;
    default_inout_pin_cap : 0.002;
    default_input_pin_cap : 0.002;
    default_output_pin_cap : 0.0;
    default_max_transition : 0.15;

    slew_lower_threshold_pct_rise : 20.0;
    slew_upper_threshold_pct_rise : 80.0;
    slew_lower_threshold_pct_fall : 20.0;
    slew_upper_threshold_pct_fall : 80.0;
    input_threshold_pct_rise : 50.0;
    input_threshold_pct_fall : 50.0;
    output_threshold_pct_rise : 50.0;
    output_threshold_pct_fall : 50.0;

    /* Bus Type Definitions */
    type (bus_5) {
        base_type : array;
        data_type : bit;
        bit_width : 5;
        bit_from : 4;
        bit_to : 0;
        downto : true;
    }
    type (bus_384) {
        base_type : array;
        data_type : bit;
        bit_width : 384;
        bit_from : 383;
        bit_to : 0;
        downto : true;
    }
    type (bus_416) {
        base_type : array;
        data_type : bit;
        bit_width : 416;
        bit_from : 415;
        bit_to : 0;
        downto : true;
    }
    type (bus_448) {
        base_type : array;
        data_type : bit;
        bit_width : 448;
        bit_from : 447;
        bit_to : 0;
        downto : true;
    }
    type (bus_480) {
        base_type : array;
        data_type : bit;
        bit_width : 480;
        bit_from : 479;
        bit_to : 0;
        downto : true;
    }

    /* Simple 1x1 Scalar Template for Clean Blackbox Timing */
    lu_table_template (scalar_template) {
        variable_1 : total_output_net_capacitance;
        index_1 ("0.01");
    }
    lu_table_template (constraint_scalar) {
        variable_1 : constrained_pin_transition;
        index_1 ("0.01");
    }

    /* =================================================================
     * CELL 1: sram_32x384 (Area: 5800.0 um^2)
     * ================================================================= */
    cell (sram_32x384) {
        area : 5800.0;
        dont_touch : true;
        dont_use : true;
        is_macro_cell : true;
        interface_timing : true;
        cell_leakage_power : 22.0;

        pin (CLK) {
            direction : input;
            clock : true;
            capacitance : 0.008;
            min_pulse_width_high : 0.15;
            min_pulse_width_low : 0.15;
            timing () {
                timing_type : min_clock_tree_path;
                timing_sense : positive_unate;
                cell_rise (scalar_template) { values ("0.0"); }
                cell_fall (scalar_template) { values ("0.0"); }
            }
        }

        pin (WEN) {
            direction : input;
            capacitance : 0.004;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.065"); }
                fall_constraint (constraint_scalar) { values ("0.065"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }

        pin (REN) {
            direction : input;
            capacitance : 0.004;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.065"); }
                fall_constraint (constraint_scalar) { values ("0.065"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }

        pin (DFT_BYPASS) {
            direction : input;
            capacitance : 0.008;
        }

        bus (WADDR) {
            bus_type : bus_5;
            direction : input;
            capacitance : 0.004;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.070"); }
                fall_constraint (constraint_scalar) { values ("0.070"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }

        bus (RADDR) {
            bus_type : bus_5;
            direction : input;
            capacitance : 0.004;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.070"); }
                fall_constraint (constraint_scalar) { values ("0.070"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }

        bus (WDATA) {
            bus_type : bus_384;
            direction : input;
            capacitance : 0.002;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.055"); }
                fall_constraint (constraint_scalar) { values ("0.055"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }

        bus (RDATA) {
            bus_type : bus_384;
            direction : output;
            max_capacitance : 0.080;
            timing () {
                related_pin : "CLK";
                timing_type : rising_edge;
                timing_sense : non_unate;
                cell_rise (scalar_template) { values ("0.245"); }
                rise_transition (scalar_template) { values ("0.035"); }
                cell_fall (scalar_template) { values ("0.245"); }
                fall_transition (scalar_template) { values ("0.035"); }
            }
        }
    }

    /* =================================================================
     * CELL 2: sram_32x416 (Area: 6200.0 um^2)
