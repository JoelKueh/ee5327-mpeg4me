            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }
        bus (WDATA) {
            bus_type : bus_416;
            direction : input;
            capacitance : 0.002;
            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;
                rise_constraint (constraint_scalar) { values ("0.055"); }
                fall_constraint (constraint_scalar) { values ("0.055"); }
            }
            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;
                rise_constraint (constraint_scalar) { values ("0.020"); }
                fall_constraint (constraint_scalar) { values ("0.020"); }
            }
        }
        bus (RDATA) {
            bus_type : bus_416;
            direction : output;
            max_capacitance : 0.080;
            timing () {
                related_pin : "CLK";
                timing_type : rising_edge;
