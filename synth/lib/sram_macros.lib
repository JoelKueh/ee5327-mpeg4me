            direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.10"); } fall_constraint (constraint_template) { values ("0.10"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (WADDR) {
            bus_type : bus_5; direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.10"); } fall_constraint (constraint_template) { values ("0.10"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (RADDR) {
            bus_type : bus_5; direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.10"); } fall_constraint (constraint_template) { values ("0.10"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (WDATA) {
            bus_type : bus_416; direction : input; capacitance : 0.002;
            timing () { related_pin : "CLK"; timing_type : setup_rising; rise_constraint (constraint_template) { values ("0.08"); } fall_constraint (constraint_template) { values ("0.08"); } }
            timing () { related_pin : "CLK"; timing_type : hold_rising;  rise_constraint (constraint_template) { values ("0.02"); } fall_constraint (constraint_template) { values ("0.02"); } }
        }
        bus (RDATA) {
            bus_type : bus_416; direction : output; max_capacitance : 0.100;
            timing () {
                related_pin : "CLK"; timing_type : rising_edge; timing_sense : non_unate;
                cell_rise (scalar_template) { values ("0.20"); }
                cell_fall (scalar_template) { values ("0.20"); }
                rise_transition (scalar_template) { values ("0.04"); }
                fall_transition (scalar_template) { values ("0.04"); }
            }
        }
    }

    /* =================================================================
       3. sram_32x448 (ADDR_W=5, DATA_W=448)
