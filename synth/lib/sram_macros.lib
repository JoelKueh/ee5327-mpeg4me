     * CELL 4: sram_128x120 (15,360 bits, 1R1W 2-Port)
     * Area: 3291.6 um^2 (~0.214 um^2/bit incl. 2P decoders & I/O)
     * Access Time: 320 ps
     * ================================================================= */
    cell (sram_128x120) {
        area : 3291.6;
        dont_touch : true;
        dont_use : true;
        is_macro_cell : true;
        interface_timing : true;
        cell_leakage_power : 13.0;

        pin (CLK) {
